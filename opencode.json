{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "multi-edit": {
      "type": "local",
      "command": ["npx", "-y", "@essentialai/mcp-multi-edit"],
      "enabled": true,
      "timeout": 30000
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "timeout": 30000
    },
    "memory-keeper": {
      "type": "local",
      "command": ["npx", "mcp-memory-keeper"],
      "enabled": true,
      "timeout": 30000,
      "environment": {
        "TOOL_PROFILE": "minimal"
      }
    }
  }
}
